DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_URL=http://127.0.0.1:5173
# On a production host behind a trusted HTTPS proxy that overwrites X-Forwarded-Proto:
# DJANGO_TRUST_PROXY_SSL_HEADER=true

# Optional: without DB_NAME, local SQLite is used.
# DB_NAME=albuz
# DB_USER=albuz
# DB_PASSWORD=replace-me
# DB_HOST=localhost
# DB_PORT=3306

# Optional: without S3_BUCKET, uploads use local private-media.
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Required only for Google Drive import.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback/
# GOOGLE_TOKEN_ENCRYPTION_KEY=
